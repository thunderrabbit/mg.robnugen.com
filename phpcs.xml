<?xml version="1.0"?>
<ruleset name="mg-starter">
    <description>
        Starter style gate for mg. Intentionally MINIMAL so it passes today and
        tightens over time (toward PSR-12). The Standards MCP check_style gate
        runs this; add rules gradually and run phpcbf to auto-fix each step.
    </description>

    <file>classes</file>
    <file>wwwroot</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!-- Low-controversy sniffs mg already satisfies. Grow this list over time. -->
    <rule ref="Generic.PHP.DisallowShortOpenTag"/>
    <rule ref="Generic.PHP.DisallowAlternativePHPTags"/>
    <rule ref="Generic.Files.ByteOrderMark"/>
    <rule ref="Generic.PHP.LowerCaseKeyword"/>
    <rule ref="Generic.PHP.LowerCaseConstant"/>

    <!-- Increment 1: whitespace hygiene (all phpcbf-fixable). -->
    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace"/>
    <rule ref="Generic.Files.LineEndings">
        <properties>
            <property name="eolChar" value="\n"/>
        </properties>
    </rule>
</ruleset>

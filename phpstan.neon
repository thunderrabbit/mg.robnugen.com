# Static analysis, run in Docker by ~/work/rob/standards-mcp/run-phpstan.sh
# and by .githooks/pre-commit. Raised a rung at a time toward level 10 (mg #505).
parameters:
    level: 5
    paths:
        - classes
        - wwwroot
        - prepend.php
        - Tests
    excludePaths:
        analyse:
            # Vendored third-party library; scanned so Utilities can use it.
            - classes/Parsedown.php
        analyseAndScan:
            # Gitignored per-server credentials; ConfigSample declares the same class.
            - classes/Config.php (?)
            # Codeception output, and the actors built from generated traits
            # that a fresh clone doesn't have.
            - Tests/_output/*
            - Tests/Support/*
    ignoreErrors:
        # Codeception builds each actor's methods ($I->amOnPage(), ...) into
        # traits under Tests/Support/_generated, which is gitignored and so
        # absent from the tree the pre-commit hook checks. Three suites also
        # share AcceptanceTester with different modules, so no one build of
        # those traits is right. Only actor method calls are ignored.
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Tests\\Support\\\w+Tester::\w+\(\)\.$#'
            path: Tests/*
    bootstrapFiles:
        - vendor/autoload.php
        # SEMVER, SENTIMENTAL_VERSION and the app-wide constants.
        - version.php
